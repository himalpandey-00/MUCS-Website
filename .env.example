# Copy this file to .env and fill in real values. Never commit .env.
#
# Supabase Postgres — Project Settings → Database → Connection string.
#   DATABASE_URL: the pooled (Supavisor) connection, port 6543. Used by the
#     app at runtime (src/lib/prisma.ts) via the @prisma/adapter-pg driver
#     adapter. `pgbouncer=true` disables prepared-statement caching, which
#     transaction-mode pooling doesn't support.
#   DIRECT_URL: the direct connection, port 5432. Used only by the Prisma
#     CLI (migrate, db seed, studio) — see prisma.config.ts — because
#     migrations need session-level features (advisory locks) that the
#     pooled connection doesn't support.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Public site URL, used for absolute URLs (OG tags, sitemap). Set to the
# real deployed URL once live.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase project API — used for Auth only (all data access still goes
# through Prisma/DATABASE_URL above, not the Supabase client).
#   NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: safe to
#     expose to the browser (that's what "publishable" means) — used by the
#     admin sign-in callback to read the session Supabase puts in the URL.
#   SUPABASE_SECRET_KEY: server-only. Grants Admin API access (inviting
#     users). Never import it from a "use client" file or log it.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
